---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Perfect Clean | Limpieza y Mantenimiento Industrial",
  description = "Servicio de limpieza especializado para sectores industriales y comerciales en Puebla, CDMX, Querétaro, Tlaxcala y Pachuca. Personal capacitado, planes a la medida y cumplimiento normativo.",
} = Astro.props;

const site = "https://perfect-clean.gbvazco.net";
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL("/og-image.svg", site).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Perfect Clean",
  description,
  url: site,
  image: ogImage,
  telephone: ["+52-222-606-0311", "+52-222-611-8518"],
  email: "perfectclean.puebla@gmail.com",
  areaServed: [
    "Puebla",
    "Ciudad de México",
    "Querétaro",
    "Tlaxcala",
    "Pachuca",
  ],
  openingHours: "Mo-Fr 08:00-17:00",
  serviceType: [
    "Limpieza industrial",
    "Mantenimiento industrial",
    "Limpieza de obra negra y fina",
    "Sanitización y fumigación",
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0b5f87" />
    <meta name="author" content="Perfect Clean" />
    <meta
      name="keywords"
      content="limpieza industrial, mantenimiento industrial, limpieza comercial, sanitización, fumigación, Puebla, CDMX, Querétaro, Tlaxcala, Pachuca"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Perfect Clean" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
